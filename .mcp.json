{
  "mcpServers": {
    "codegraph": {
      "command": "npx",
      "args": [
        "-y",
        "@colbymchenry/codegraph",
        "serve",
        "--mcp",
        "--path",
        "."
      ],
      "env": {
        "CODEGRAPH_TELEMETRY": "0"
      }
    },
    "piratex": {
      "type": "http",
      "url": "https://piratex.ai/api/mcp"
    }
  }
}